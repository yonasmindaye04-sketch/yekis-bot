APP_NAME=Yekis Intelligence
APP_ENV=development
API_PREFIX=/api/v1

# Required. For Docker Compose use host "db" and port 5432.
DATABASE_URL=postgresql+psycopg://yekis_intel:yekis_intel_dev@localhost:5440/yekis_intelligence

# Development convenience only. In controlled environments run:
#   alembic upgrade head
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO

# --- Telegram collector (M1) ---
# Credentials come from https://my.telegram.org and must never be committed.
TELEGRAM_ENABLED=false
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-me
TELEGRAM_SESSION_PATH=var/telegram_collector
TELEGRAM_FETCH_LIMIT=100

# --- Background processing (M2) ---
REDIS_URL=redis://localhost:6382/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_MAX_RETRIES=5
COLLECT_INTERVAL_SECONDS=900
