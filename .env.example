APP_NAME=Yekis Intelligence
APP_ENV=development
API_PREFIX=/api/v1

# Required. For Docker Compose use host "db" and port 5432.
DATABASE_URL=postgresql+psycopg://yekis_intel:yekis_intel_dev@localhost:5440/yekis_intelligence

# Development convenience only. In controlled environments run:
#   alembic upgrade head
AUTO_CREATE_SCHEMA=true
LOG_LEVEL=INFO

# --- Authentication (M4) ---
# JSON object: key -> {role, name}. Keys must be >= 16 characters.
# Development-only sample values; replace before any shared deployment.
AUTH_API_KEYS={"dev-admin-key-change-me-01":{"role":"admin","name":"dev-admin"},"dev-reviewer-key-change-me-01":{"role":"reviewer","name":"dev-reviewer"},"dev-collector-key-change-me-01":{"role":"collector","name":"dev-collector"},"dev-analyst-key-change-me-01":{"role":"analyst","name":"dev-analyst"}}
AUTH_ALLOW_ANONYMOUS_DEV=false
# Explicit browser origins only; never "*".
CORS_ORIGINS=

# --- Telegram collector (M1) ---
# Credentials come from https://my.telegram.org and must never be committed.
TELEGRAM_ENABLED=false
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=replace-me
# Bot credentials: used for PUBLISHING only. Telegram bots cannot read channel
# history, so the collector always uses a user session.
# TELEGRAM_BOT_TOKEN=123456:replace-me
# User session for the collector (created by: python -m app.integrations.telegram.login --as user)
TELEGRAM_SESSION_PATH=var/telegram_user
# Bot session for the publisher (created by: python -m app.integrations.telegram.login --as bot)
TELEGRAM_BOT_SESSION_PATH=var/telegram_bot
TELEGRAM_FETCH_LIMIT=100

# --- Telegram proxy (Cloudflare) ---
# Telegram MTProto traffic can be routed through a SOCKS5 or HTTP proxy. This is
# the supported way to reach Telegram from a restricted network, for example via
# a Cloudflare WARP local proxy or a Cloudflare Tunnel (cloudflared) in front of
# a SOCKS5 endpoint. Leave empty to connect directly.
# Cloudflare WARP in proxy mode exposes SOCKS5 on 127.0.0.1:40000.
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=40000
# TELEGRAM_PROXY_RDNS=true

# --- Background processing (M2) ---
REDIS_URL=redis://localhost:6382/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_MAX_RETRIES=5
CELERY_RETRY_BASE_SECONDS=10
CELERY_RETRY_MAX_SECONDS=3600
CELERY_TASK_TIME_LIMIT_SECONDS=300
COLLECT_INTERVAL_SECONDS=900

# --- Extraction (M3) ---
# rules (default), gemini (Google AI Studio), or llm (OpenAI-compatible).
# A missing key falls back to rules with a warning; it never blocks ingestion.
EXTRACTION_PROVIDER=rules

# Google Gemini via AI Studio (https://aistudio.google.com/app/apikey).
# GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible provider (only used when EXTRACTION_PROVIDER=llm).
# --- NVIDIA NIM preset (https://build.nvidia.com) ---
# EXTRACTION_PROVIDER=llm
# LLM_API_KEY=your_nvidia_api_key
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# --- OpenAI preset ---
# LLM_API_KEY=replace-me
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# "json_object" asks for JSON mode. Use "none" for deployments that reject it.
LLM_RESPONSE_FORMAT=json_object
# Optional provider-specific request fields as a JSON object, for example
# NVIDIA NIM guided decoding. Leave empty for none.
LLM_EXTRA_BODY=

# Shared limits for both LLM providers.
# NVIDIA NIM cold starts can exceed 30 seconds; 120 is recommended.
LLM_TIMEOUT_SECONDS=120
# Bounded retry for transient provider failures (timeout, 429, 5xx).
LLM_MAX_ATTEMPTS=2
LLM_RETRY_WAIT_SECONDS=5
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=800

# --- Publishing (M5) ---
# Off by default. Never enable against a real channel during development.
PUBLISHING_ENABLED=false
# Comma-separated allowlist; publishing fails closed when empty.
PUBLISHING_ALLOWED_CHANNELS=
PUBLISHING_MAX_ATTEMPTS=3
